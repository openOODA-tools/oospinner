# Maintainer: openOODA-tools <ops@openooda.org>
pkgname=oospinner-bin
_pkgname=oospinner
pkgver=0.1.0
pkgrel=1
pkgdesc="Animated terminal spinners with Unicode braille, dots, and oote theme colors."
arch=('x86_64')
url="https://github.com/openOODA-tools/oospinner"
license=('Apache-2.0')
depends=('glibc')
provides=('oospinner')
conflicts=('oospinner')
source_x86_64=("${url}/releases/download/v${pkgver}/oospinner-linux-x86_64"
               "uninstall.sh::https://raw.githubusercontent.com/openOODA-tools/${_pkgname}/v${pkgver}/uninstall.sh")
sha256sums_x86_64=('SKIP'
                   'SKIP')

package() {
    install -Dm755 "${srcdir}/oospinner-linux-x86_64" "${pkgdir}/usr/bin/oospinner"
    install -Dm755 uninstall.sh "${pkgdir}/usr/bin/oospinner-uninstall"
}
